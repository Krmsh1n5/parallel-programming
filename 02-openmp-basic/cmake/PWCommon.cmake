include_guard(GLOBAL)
include(CTest)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
option(PW_ENABLE_OPENMP "Build OpenMP exercises" ON)
option(PW_ENABLE_MPI "Build MPI exercises" ON)
option(PW_BUILD_SOLUTIONS "Build instructor solutions alongside student programs" OFF)
function(pw_program target source model solution)
  if((model STREQUAL "omp" OR model STREQUAL "hybrid") AND NOT PW_ENABLE_OPENMP)
    return()
  endif()
  if((model STREQUAL "mpi" OR model STREQUAL "hybrid") AND NOT PW_ENABLE_MPI)
    return()
  endif()
  add_executable(${target} ${source})
  target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/common")
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  endif()
  if(model STREQUAL "omp" OR model STREQUAL "hybrid")
    find_package(OpenMP REQUIRED COMPONENTS CXX)
    target_link_libraries(${target} PRIVATE OpenMP::OpenMP_CXX)
  endif()
  if(model STREQUAL "mpi" OR model STREQUAL "hybrid")
    find_package(MPI REQUIRED COMPONENTS CXX)
    target_link_libraries(${target} PRIVATE MPI::MPI_CXX)
  endif()
  set(test_args ${ARGN})
  if(NOT target MATCHES "(b3_affinity|b4_alignment|c5_false_sharing|d3_ring|d4_ring)$")
    list(APPEND test_args --self-test)
  endif()
  if(solution AND BUILD_TESTING)
    if(model STREQUAL "mpi" OR model STREQUAL "hybrid")
      foreach(ranks 1 2 3 4)
        add_test(NAME ${target}_p${ranks}
          COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} ${ranks} ${MPIEXEC_PREFLAGS}
          $<TARGET_FILE:${target}> ${MPIEXEC_POSTFLAGS} ${test_args})
        set_tests_properties(${target}_p${ranks} PROPERTIES TIMEOUT 45
          ENVIRONMENT "OMP_NUM_THREADS=2;OMP_DYNAMIC=false")
      endforeach()
    elseif(model STREQUAL "omp")
      foreach(threads 1 2 4)
        add_test(NAME ${target}_t${threads} COMMAND ${target} ${test_args})
        set_tests_properties(${target}_t${threads} PROPERTIES TIMEOUT 45
          ENVIRONMENT "OMP_NUM_THREADS=${threads};OMP_DYNAMIC=false")
      endforeach()
    else()
      add_test(NAME ${target} COMMAND ${target} ${test_args})
      set_tests_properties(${target} PROPERTIES TIMEOUT 45)
    endif()
  endif()
endfunction()
