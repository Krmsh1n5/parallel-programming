include_guard(GLOBAL)
include(CTest)
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
option(PW_ENABLE_OPENMP "Build OpenMP exercises" ON)
option(PW_ENABLE_MPI "Build MPI exercises" ON)
option(PW_BUILD_SOLUTIONS "Build instructor solutions" OFF)
function(pw_program target source model solution)
  if(model STREQUAL "omp" AND NOT PW_ENABLE_OPENMP)
    return()
  endif()
  if(model STREQUAL "mpi" AND NOT PW_ENABLE_MPI)
    return()
  endif()
  add_executable(${target} ${source})
  target_link_libraries(${target} PRIVATE m)
  if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  endif()
  if(model STREQUAL "omp")
    find_package(OpenMP REQUIRED COMPONENTS C)
    target_link_libraries(${target} PRIVATE OpenMP::OpenMP_C)
  endif()
  if(model STREQUAL "mpi")
    find_package(MPI REQUIRED COMPONENTS C)
    target_link_libraries(${target} PRIVATE MPI::MPI_C)
  endif()
endfunction()
